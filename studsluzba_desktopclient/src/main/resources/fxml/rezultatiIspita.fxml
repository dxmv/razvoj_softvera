<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.RezultatiIspitaController">
    <top>
        <fx:include source="menuBar.fxml"/>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Ispitni rok:"/>
                <ComboBox fx:id="cbRokovi" prefWidth="150" promptText="Izaberi rok"/>

                <Label text="Ispit:"/>
                <ComboBox fx:id="cbIspiti" prefWidth="250" promptText="Izaberi ispit"/>

                <Button text="Prikaži rezultate" onAction="#handlePrikazi"/>
                <Button text="Štampaj zapisnik" onAction="#handleStampajZapisnik" style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
            </HBox>

            <TableView fx:id="tblRezultati" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIndeks" text="Indeks"/>
                    <TableColumn fx:id="colStudent" text="Student"/>
                    <TableColumn fx:id="colProgram" text="Program"/>
                    <TableColumn fx:id="colPredispitni" text="Predispitni"/>
                    <TableColumn fx:id="colIspit" text="Ispit"/>
                    <TableColumn fx:id="colUkupno" text="Ukupno"/>
                    <TableColumn fx:id="colOcena" text="Ocena"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
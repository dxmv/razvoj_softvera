<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<TabPane fx:id="predmetTabPane" xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.raflab.studsluzbadesktopclient.controllers.PredmetController"
         tabClosingPolicy="UNAVAILABLE">

    <Tab fx:id="tabPregled" text="Pregled po programu">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Studijski program:"/>
                <ComboBox fx:id="studProgramCb" prefWidth="250"/>
            </HBox>
            <TableView fx:id="predmetiTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colSifra" text="Šifra" prefWidth="100"/>
                    <TableColumn fx:id="colNaziv" text="Naziv" prefWidth="250"/>
                    <TableColumn fx:id="colEspb" text="ESPB" prefWidth="70"/>
                    <TableColumn fx:id="colSemestar" text="Semestar" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <Tab fx:id="tabNovi" text="Novi predmet">
        <VBox alignment="TOP_CENTER" spacing="20">
            <padding>
                <Insets top="40" right="20" bottom="20" left="20"/>
            </padding>
            <GridPane hgap="15" vgap="15" alignment="CENTER">
                <Label text="Naziv predmeta:" GridPane.halignment="RIGHT" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nazivField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

                <Label text="Šifra:" GridPane.halignment="RIGHT" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="sifraField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="ESPB bodovi:" GridPane.halignment="RIGHT" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="espbField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Semestar:" GridPane.halignment="RIGHT" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="semestarField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Program:" GridPane.halignment="RIGHT" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <ComboBox fx:id="studProgramUnosCb" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300"/>
            </GridPane>

            <Button text="Sačuvaj predmet" onAction="#handleSave" prefWidth="150" style="-fx-font-size: 14px;"/>
        </VBox>
    </Tab>

    <Tab fx:id="tabStatistika" text="Statistika">
        <VBox alignment="TOP_CENTER" spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox spacing="10" alignment="CENTER">
                <Label text="Studijski program:"/>
                <ComboBox fx:id="statProgramCb" prefWidth="200"/>
                <Label text="Od godine:"/>
                <TextField fx:id="godinaOdField" prefWidth="60" text="2020"/>
                <Label text="Do godine:"/>
                <TextField fx:id="godinaDoField" prefWidth="60" text="2026"/>
                <Button text="Generiši izveštaj" onAction="#handleIzracunajStatistiku"/>
            </HBox>
            <TableView fx:id="statistikaTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colStatPredmet" text="Predmet" prefWidth="250"/>
                    <TableColumn fx:id="colStatProsek" text="Prosečna ocena" prefWidth="120"/>
                    <TableColumn fx:id="colStatPeriod" text="Period" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>
</TabPane>
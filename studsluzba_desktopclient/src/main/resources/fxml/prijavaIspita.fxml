<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.raflab.studsluzbadesktopclient.controllers.PrijavaIspitController">

    <top>
        <fx:include source="menuBar.fxml"/>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Prijava ispita" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Indeks (ID):"/>
                <TextField fx:id="indeksTf"/>
                <Button fx:id="proveriBtn" text="Proveri" onAction="#handleProveriStudenta"/>
            </HBox>

            <Label fx:id="studentInfoLbl" text="" style="-fx-text-fill: blue; -fx-font-weight: bold;"/>

            <Separator/>

            <GridPane hgap="10" vgap="10">
                <Label text="Rok:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="rokCb" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Ispit:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="ispitCb" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <Button fx:id="prijaviBtn" text="Prijavi ispit" onAction="#handlePrijaviIspit"
                    maxWidth="Infinity" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
        </VBox>
    </center>
</BorderPane>